{
    "baseUrl": "http://localhost:3000",
    "env": {
        "apiUrl": "http://localhost:3002",
        "TAGS": "not @skip",
        "coverage": true,
        "mapCoverage": true,
        "mapNodeCoverage": true,
        "verboseFailures": true,
        "codeCoverage": {
            "url": "http://localhost:3002/__coverage__",
            "exclude": "cypress/**/*.*"
        }
    }
}
